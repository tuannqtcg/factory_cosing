# Chỉ cần khi có Firebase project THẬT (chưa có thì để trống — app tự chạy
# Emulator Suite, xem docs/M12_PLAN.md "Quyết định hạ tầng").
# Copy file này thành `.env` (đã bị .gitignore chặn commit) rồi điền giá trị
# thật từ Console Firebase (Project settings → General → Your apps → Web app).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Chỉ cần nếu database Firestore KHÔNG đặt tên "(default)" (ADR-016) — để
# trống nếu bạn dùng "(default)".
VITE_FIREBASE_DATABASE_ID=
