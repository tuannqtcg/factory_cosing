{
  "firestore": {
    "database": "manufacture",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "emulators": {
    "firestore": {
      "port": 8081
    },
    "auth": {
      "port": 9100
    },
    "functions": {
      "port": 5002
    },
    "ui": {
      "port": 4001,
      "enabled": true
    }
  }
}
